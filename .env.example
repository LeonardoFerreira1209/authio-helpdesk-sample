# ---------------------------------------------------------------------------
# helpdesk.app — aplicação de exemplo que delega identidade ao Authio
#
# Copie para .env.local e preencha. Ela roda no host, com `npm run dev`, na
# porta 3200 — fora do docker-compose, como a bancada: dentro da rede do compose
# ela leria o discovery em http://authio.api:8080 e teria de devolver ao
# navegador um authorize em http://localhost:5000, dois issuers para a mesma
# instância, o que quebra a validação de `iss` do id_token.
# ---------------------------------------------------------------------------

# Issuer do realm. A aplicação deriva o nome do realm daqui — é a única fonte.
NEXT_PUBLIC_AUTHIO_ISSUER="http://localhost:5000/realms/authio"

# O client cadastrado no Authio PARA ESTA APLICAÇÃO.
#
# Vale a pena ser um client só dela, e não o "authio" do console: o Authio
# compara a redirect_uri por origem, e esta aplicação atende em
# http://localhost:3200 enquanto o console atende em :3000. Um client só não
# cobre as duas origens.
#
# Registre no client:
#   redirect_uri            http://localhost:3200/api/auth/callback/authio
#   post_logout_redirect    http://localhost:3200/sign-in
#   grants                  authorization_code, refresh_token
#   escopos                 openid, profile, email, offline_access
#   auth method             client_secret_basic
AUTHIO_ID="helpdesk"
AUTHIO_CLIENT_SECRET="o-segredo-do-client-helpdesk"

# Chave que cifra o cookie de sessão desta aplicação. Diferente do segredo do
# client de propósito: girar a credencial no Authio não deve derrubar toda
# sessão aberta, e quem lesse o segredo do lado do Authio não deve conseguir
# forjar um cookie daqui.
#   openssl rand -base64 32
AUTH_SECRET="valor-aleatorio-so-desta-aplicacao"

# URL pública desta aplicação. Monta os redirect_uri.
NEXTAUTH_URL="http://localhost:3200"


# ---------------------------------------------------------------------------
# Admin API — o que faz os painéis "Meu perfil" e "Equipe" funcionarem
#
# Os endpoints /api/v1/admin são guardados por uma claim, não por um escopo: o
# token precisa carregar system_resource_access (usuário marcado como system,
# responsável pelo realm) ou secret_resource_access (uma chave de API com
# papéis). Um token tirado só com o segredo do client autentica perfeitamente e
# é recusado com 403 por TODOS eles — que é o erro mais confuso de diagnosticar
# aqui, porque parece API quebrada e é credencial errada.
# ---------------------------------------------------------------------------

AUTHIO_URL="http://localhost:5000"

# Usuário system do realm. É por ele que sai o token administrativo.
AUTHIO_ADMIN_USERNAME=""
AUTHIO_ADMIN_PASSWORD=""

# O segredo apresentado ao token endpoint junto com o usuário acima. Tem de ser
# o segredo do PRÓPRIO client da plataforma (o "authio"), não o do client desta
# aplicação: o Authio cobra de cada client a sua própria credencial.
AUTHIO_ADMIN_SECRET=""

# O realm e o client pelos quais o Authio administra a si mesmo. A migration
# semeia os dois como "authio"; são linhas de banco, não constantes do
# protocolo.
AUTHIO_PLATFORM_REALM="authio"
AUTHIO_PLATFORM_CLIENT="authio"
